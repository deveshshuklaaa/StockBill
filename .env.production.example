# StockBill production settings for docker-compose.prod.yml.
# Copy to .env.production on the server (never commit it) and replace every
# placeholder. Django refuses to start with DEBUG off and a placeholder key.

# ---- Django
DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# Public hostname(s), plus localhost/127.0.0.1 for the container healthcheck
# and local checks on http://127.0.0.1:8080.
ALLOWED_HOSTS=stockbill.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://stockbill.example.com
# Frontend and API share one origin behind nginx, so CORS stays off.
CORS_ALLOWED_ORIGINS=
# HSTS: start short; raise (e.g. 31536000) once HTTPS has run without trouble.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Mount /admin/ (Django admin). Keep false unless you need it for a while.
ENABLE_DJANGO_ADMIN=False
# Login token lifetime in hours (168 = 7 days).
TOKEN_TTL_HOURS=168
# Login attempts allowed per client address.
LOGIN_THROTTLE_RATE=5/min
# Key login throttling on Cloudflare's CF-Connecting-IP (real client).
# Only safe behind the tunnel with deploy/nginx/stockbill.conf.
TRUST_CF_CONNECTING_IP=True
# Keep NUM_PROXIES=0 so X-Forwarded-For is ignored (see
# deploy/README-production.md, "Client address and login throttling").
NUM_PROXIES=0
LOG_LEVEL=WARNING

# GST document-number prefixes (full number must stay <= 16 chars)
INVOICE_NUMBER_PREFIX=DE
CREDIT_NOTE_NUMBER_PREFIX=CN

# ---- Gunicorn
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ---- PostgreSQL (the db container creates this database and user on first start)
POSTGRES_DB=stockbill
POSTGRES_USER=stockbill
POSTGRES_PASSWORD=change-me-db-password
# Django connects with the same credentials (DB_HOST/DB_PORT are set in compose).
DB_NAME=stockbill
DB_USER=stockbill
DB_PASSWORD=change-me-db-password

# ---- Cloudflare Tunnel (only with: docker compose --profile tunnel ...)
TUNNEL_TOKEN=
